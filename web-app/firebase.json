{
  "hosting": {
    "site": "meesho-otp-app",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.apk"
    ],
    "redirects": [
      {
        "source": "/ordermunim_v:version.apk",
        "destination": "https://raw.githubusercontent.com/RRTraders/ordermunim_live/main/ordermunim_v:version.apk",
        "type": 302
      },
      {
        "source": "/meesho_otp.apk",
        "destination": "https://raw.githubusercontent.com/RRTraders/ordermunim_live/main/ordermunim_v4.8.apk",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
